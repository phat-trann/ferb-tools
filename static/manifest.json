{
  "manifest_version": 3,
  "name": "FerbTools",
  "description": "FerbTools is a Chrome extension toolkit. Current tool: check-in and checkout reminders. Made by Ferb.",
  "version": "1.9.1",
  "permissions": ["storage", "tabs", "alarms", "scripting"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "app/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["features/content-asset/config.js", "features/content-asset/content-asset-export.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "FerbTools • Made by Ferb",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
